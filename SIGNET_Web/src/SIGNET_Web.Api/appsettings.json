{
  "Logging": { "LogLevel": { "Default": "Warning", "SIGNET_Web": "Information" } },
  "Urls": "http://localhost:5080",
  "Signet": {
    "NombreSistema": "SIGNET",
    // Archivo Setup.xml (encriptado) del sistema de escritorio con las bases disponibles.
    // Ruta absoluta o relativa a la carpeta del proyecto/ejecutable.
    "SetupXmlPath": "..\\..\\..\\SIGNET\\SIGNET\\Setup.xml",
    // Alternativa / complemento a Setup.xml (se agregan a las del Setup.xml):
    // { "Name": "Empresa", "DataSource": "servidor,puerto", "DataBase": "Base", "User": "usuario", "Pass": "clave", "Provider": "System.Data.SqlClient" }
    "Bases": [],
    // Opt-in: requiere migracion 003 y politicas autorizadas. Solo nombres de variables; nunca cadenas de conexion aqui.
    "ContabilidadWorker": {
      "Habilitado": false,
      "IntervaloSegundos": 30,
      "ConexionesVariables": []
    },
    "SessionMinutes": 480,
    // Pantalla de ingreso (todo opcional). Imagen: archivo (svg/png/jpg/webp) o carpeta con varias (se elige una al azar en cada ingreso).
    "Login": {
      "Imagen": "Personalizacion\\Login",
      "Titulo": "",
      "Mensaje": "Gestión integral de su empresa",
      "Color": "",
      "Pie": ""
    },
    // Asistente de datos (IA): clave, modelo y tope mensual en Parámetros del sistema (IA_*), igual que en el escritorio.
    "Chat": {
      "Habilitado": true
    },
    "MaxFilasBusqueda": 5000,
    // Campos de configuración visual del escritorio que no se muestran en la web
    "CamposOcultos": [ "Tema", "BackColor", "BackImage", "RibbonMinimizado", "TituloTile", "TileConfig", "Indicadores" ],
    // Correcciones manuales Manager -> Formulario de seguridad (si el nombre no coincide)
    "Formularios": { "PuntosVenta": "PuntosVentas", "ProvFinancierosCuentas": "ProvFinancieroCuentas" }
  }
}
