<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="CurrentComputerName" value="WEB" />
  </appSettings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
  <!-- Servicios SOAP de Sisorg (copiado de VENET_Personal_Sisorg\app.config) -->
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="TokenSoap" maxReceivedMessageSize="2147483647" />
        <binding name="TripulanteSoap" maxReceivedMessageSize="2147483647" />
        <binding name="ViajeSoap" maxReceivedMessageSize="2147483647" />
        <binding name="VehiculoSoap" maxReceivedMessageSize="2147483647" />
        <binding name="TerminalSoap" maxReceivedMessageSize="2147483647" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://200.32.4.146/ERSA/TFC_Layer/token.asmx" binding="basicHttpBinding" bindingConfiguration="TokenSoap" contract="Token.TokenSoap" name="TokenSoap" />
      <endpoint address="http://200.32.4.146/ERSA/TFC_Layer/tripulante.asmx" binding="basicHttpBinding" bindingConfiguration="TripulanteSoap" contract="Tripulante.TripulanteSoap" name="TripulanteSoap" />
      <endpoint address="http://200.32.4.146/ERSA/TFC_Layer/Viaje.asmx" binding="basicHttpBinding" bindingConfiguration="ViajeSoap" contract="Viajes.ViajeSoap" name="ViajeSoap" />
      <endpoint address="http://200.32.4.146/ERSA/TFC_Layer/vehiculo.asmx" binding="basicHttpBinding" bindingConfiguration="VehiculoSoap" contract="Vehiculos.VehiculoSoap" name="VehiculoSoap" />
      <endpoint address="http://200.32.4.146/ERSA/TFC_Layer/Terminal.asmx" binding="basicHttpBinding" bindingConfiguration="TerminalSoap" contract="Terminales.TerminalSoap" name="TerminalSoap" />
    </client>
  </system.serviceModel>
</configuration>
